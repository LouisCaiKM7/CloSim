# CloSim master server — environment template.
# Copy to `.env` and fill in. EVERY value here is a BLANK placeholder — the user provides real
# values. Never commit a filled-in .env (it is gitignored). Nothing is hardcoded in source.
#
# The .env file is loaded by `--env-file` (Node 20+) or your process manager / IaC. See README.

# --- Bind ---------------------------------------------------------------------------------------
# Port the HTTP service listens on. Blank => default 8080.
PORT=
# Interface to bind. Blank => 0.0.0.0 (all). Use 127.0.0.1 to restrict to localhost.
BIND_HOST=

# --- Auth (client credential that gates the directory API) --------------------------------------
# Comma-separated client API keys the game exe sends as `X-Api-Key`. Supports multiple for rotation.
# BLANK by default. Generate a random key, e.g.:  node -e "console.log(require('crypto').randomUUID())"
# TODO: user provides. In AWS this comes from Secrets Manager (see deploy/), not this file.
CLIENT_API_KEYS=
# Local-dev ONLY escape hatch: run without any key. Never set true in a real deploy (config refuses it).
ALLOW_INSECURE_NO_AUTH=

# --- TTL / heartbeat model (keep consistent with the game client) -------------------------------
# Client cadence (MasterServerConfig): HeartbeatSeconds=15, RoomTtlSeconds=45 (~3 missed beats).
# Blank => defaults below.
ROOM_TTL_SECONDS=
HEARTBEAT_SECONDS=
# How often the reaper sweeps expired rooms. Blank => 10.
SWEEP_INTERVAL_SECONDS=

# --- Misc ---------------------------------------------------------------------------------------
# Safety cap on directory size (in-memory store). Blank => 5000.
MAX_ROOMS=
# Free-form region label surfaced in /healthz only. Blank => "".  # TODO: user provides (optional)
REGION_LABEL=
# error | warn | info | debug. Blank => info.
LOG_LEVEL=

# --- Replay persistence (blobs in S3, metadata in a pluggable store) -----------------------------
# Replays PERSIST (unlike ephemeral rooms). Opaque replay blobs live in S3; small queryable metadata
# lives in a pluggable store. EVERY value here is BLANK — the service still boots and runs with NO
# AWS configured: blank bucket => in-memory dev blob store, blank table => in-memory metadata store
# (both volatile / single-process — dev only). Fill these in for real persistence.
#
# S3 bucket that holds the opaque replay blobs. Blank => in-memory dev blob store (no persistence).
# TODO: user provides (created by deploy/replays.tf, or bring your own private bucket).
REPLAY_S3_BUCKET=
# Region of the bucket + DynamoDB table (also used to construct the AWS SDK clients). Blank => SDK
# default region resolution. # TODO: user provides (e.g. us-east-1)
REPLAY_S3_REGION=
# Key prefix under which blobs are stored in the bucket. Blank => "replays/".
REPLAY_S3_PREFIX=
# OPTIONAL DynamoDB table for durable, horizontally-shared metadata. Blank => in-memory metadata
# store (default). # TODO: user provides (optional; created by deploy/replays.tf)
REPLAY_TABLE=
# TTL (seconds) of the short-lived presigned upload (PUT) URL. Blank => 900 (15 min).
REPLAY_UPLOAD_URL_TTL_SECONDS=
# TTL (seconds) of the short-lived presigned download (GET) URL. Blank => 900 (15 min).
REPLAY_DOWNLOAD_URL_TTL_SECONDS=
# Hard cap on a declared replay blob size in bytes. Blank => 52428800 (50 MiB).
REPLAY_MAX_SIZE_BYTES=
# Safety cap on the IN-MEMORY metadata store only (ignored when REPLAY_TABLE is set). Blank => 10000.
MAX_REPLAYS=

# AWS credentials/region for the S3 + DynamoDB clients come from the STANDARD AWS chain
# (AWS_REGION / AWS_ACCESS_KEY_ID / instance role), NOT from this file. In AWS they come from the App
# Runner instance role (see deploy/). Never hardcode credentials here.
